class Solution(object):
    def beautySum(self, s):
        n=len(s)
        ans=0
        for i in range(n):
            freq=[0]*26
            for j in range(i,n):
                freq[ord(s[j])-ord("a")]+=1
                mx=max(freq)
                mn=min(x for x in freq if x>0)
                ans+=mx-mn
        return ans

        
